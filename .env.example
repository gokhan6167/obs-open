# === OBS ortam değişkenleri (örnek). Gerçek .env asla commit edilmez. ===

# Dağıtım modu: single-tenant (on-prem) | multi-tenant (SaaS)
DEPLOYMENT_MODE=multi-tenant

# --- API ---
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
# NOT: uygulama bağlantısı RLS'e tabi 'obs_app' rolüyle yapılır (migration ile açılır).
DATABASE_URL=postgres://obs_app:obs_app_dev_password@localhost:5432/obs
# Migration/DDL için süper rol (RLS bypass) — sadece migrate ve seed'de kullanılır.
DATABASE_MIGRATE_URL=postgres://obs:obs_dev_password@localhost:5432/obs

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 uyumlu / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=obs
S3_SECRET_KEY=obs_dev_password
S3_BUCKET=obs-documents

# --- SMTP (dev: MailHog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="OBS <no-reply@obs.local>"

# --- Auth / kripto ---
# Üretimde güçlü rastgele değerler; kodda sır YOK.
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
ACCESS_TOKEN_TTL=900          # 15 dk (saniye)
REFRESH_TOKEN_TTL=1209600     # 14 gün (saniye)

# --- Güvenlik: auth stub ---
# Gerçek JWT auth gelene kadar actor kimliği/rolleri x-user-id / x-user-roles
# başlığından okunur — SADECE bu bayrak 'true' iken. Production'da açılamaz
# (uygulama ayağa kalkmaz). Gerçek ortamda ingress bu başlıkları silmelidir.
AUTH_STUB_ENABLED=false

# --- Zaman dilimi ---
TZ=Europe/Istanbul
