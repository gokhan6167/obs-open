{
  "name": "obs",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant Üniversite Öğrenci Bilgi Sistemi (OBS)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "turbo run test:isolation",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @obs/api db:migrate",
    "db:seed": "pnpm --filter @obs/api db:seed",
    "prepare": "husky || true"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.1.0",
      "vite": "^6.4.3",
      "js-yaml": "^4.3.1",
      "fast-uri": "^3.1.5",
      "esbuild": ">=0.25.0",
      "lodash": "^4.18.1",
      "qs": "^6.15.3",
      "postcss": "^8.5.25",
      "body-parser": ">=1.20.6 <2",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@>=4 <5.0.9": ">=5.0.9",
      "file-type": "^21.3.2",
      "uuid": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-36xv-jgw5-4q75"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
