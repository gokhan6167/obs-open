{
  "name": "@obs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OBS backend — NestJS modüler monolit (api + worker rolleri).",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:demo": "tsx src/db/demo-seed.ts",
    "db:demo-login": "tsx src/db/demo-login-seed.ts",
    "db:demo-staff": "tsx src/db/demo-staff-seed.ts",
    "db:demo-deep": "tsx src/db/demo-deep-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@obs/academic-core": "workspace:*",
    "@sentry/node": "^10.69.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@obs/config": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
